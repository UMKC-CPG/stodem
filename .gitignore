# See https://help.github.com/articles/ignoring-files for more about
# ignoring files.
#
# If you find yourself ignoring temporary files generated by your text
# editor or operating system, you probably want to add a global ignore
# instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Python bytecode
__pycache__/

# Install databases, binaries, and packaged distributions
/share
/bin
/distrib

# Per-job working directories (local input/output)
/jobs

# CMake build artifacts
/build

# Editor / OS scratch files
*.swp
*.swo
*~
.vimspector.json

# Runtime execution log (regenerated each run; see CLAUDE.md)
/command

# Local (non-shared) Claude Code settings; .claude/commands/ stays tracked
.claude/settings.local.json
